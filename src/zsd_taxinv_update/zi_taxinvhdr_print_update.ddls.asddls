      TimeOfInvoice           : abap.tims;
      DateOfRemoval           : abap.dats;
      TimeOfRemoval           : abap.tims;
      Discountflag            : abap.char(1);
      Freightflag             : abap.char(1);
      IGSTflag                : abap.char(1);
      CGSTflag                : abap.char(1);
      SGSTflag                : abap.char(1);
      UTGSTflag               : abap.char(1);
      TCSflag                 : abap.char(1);
