@Metadata.layer: #CUSTOMER
@UI: { headerInfo: {
typeName: 'Purchase Register Report',
typeNamePlural: 'Purchase Register Reports',
title: { type: #STANDARD, value: 'PurchaseOrder' }         } }
annotate entity ZPUR_REG_HPV
    with 
{



     @UI.facet: [ { id:              'PurchaseOrder',
                      purpose:         #STANDARD,
                      type:            #IDENTIFICATION_REFERENCE,
                      label:           'Purchase Header',
                      position:        10 } ,
                    { id:              'PurchaseOrderItem',
                      purpose:         #STANDARD,
                      type:            #LINEITEM_REFERENCE,
                      label:           'Purchase Order Details',
                      position:        20,
                      targetElement:   '_Items'} ]
    @UI.hidden: true
    Uuid;
//    @UI.selectionField: [{ position: 10 }]
//    @UI.lineItem: [{ position: 10, label: 'Purchase Order' }]
//    @UI.identification: [{ position: 10, label: 'Purchase Order' }]
    @UI.hidden: true
    PurchaseOrder;
//    @UI.lineItem: [{ position: 20, label: 'Status' }]
//    @UI.identification: [{ position: 20, label: 'Status' }]
    @UI.hidden: true
    Status;
    @UI.lineItem: [{ position: 30, label: 'From Date' }]
    @UI.identification: [{ position: 30, label: 'From Date' }]
    Fromdate;
    @UI.lineItem: [{ position: 40, label: 'To Date' }]
    @UI.identification: [{ position: 40, label: 'To Date' }]
    Todate;
    @UI.lineItem: [{ position: 50, label: 'Created By' }]
    @UI.identification: [{ position: 50, label: 'Created By' }]
    Createdby;
    @UI.lineItem: [{ position: 60, label: 'Created On' }]
    @UI.identification: [{ position: 60, label: 'Created On' }]
    Createdon;
    /* Associations */
    @UI.hidden: true
    _Items;
    
}