@Metadata.layer: #CORE

@UI: { headerInfo: {
typeName: 'Payment Dashboard',
typeNamePlural: 'Payment Dashboard',
title: { type: #STANDARD, value: 'Accountingdoc' }
}}

@UI: {
  presentationVariant: [{ sortOrder: [{ by: 'Accountingdoc', direction: #ASC } ],
                          visualizations: [{type: #AS_LINEITEM}]
                           }]
                          }
annotate entity ZC_bank_stat_head
    with 
{
   @UI.facet:
       [{ id: 'GeneralData', isSummary: true, label: 'Payment Dashboard', type: #COLLECTION },
        { type: #FIELDGROUP_REFERENCE, targetQualifier: 'GeneralData1', parentId: 'GeneralData', position: 1, label: 'Section 1', id: 'GeneralData1' },
         {
       id: 'Generalitem',
       label: 'Payment Invoices',
       type: #LINEITEM_REFERENCE,
       targetElement: '_item',
       position:  2
       },
        {
       id: 'Generalitem1',
       label: 'Approver Log',
       type: #LINEITEM_REFERENCE,
       targetElement: '_item1',
       position:  3
       }
       ]
  @Search.defaultSearchElement: true
  @UI: { lineItem: [{ position: 10 },{type: #FOR_INTENT_BASED_NAVIGATION, semanticObjectAction: 'displayFactSheet'}],
       identification: [{ position: 10 }],
       fieldGroup: [{ qualifier: 'GeneralData1', position: 10, importance: #HIGH }] ,
       selectionField: [{ position: 10 }] }
       @Consumption.semanticObject: 'AccountingDocument'
