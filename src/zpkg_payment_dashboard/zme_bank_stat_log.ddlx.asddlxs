@Metadata.layer: #CORE
@UI: {
  presentationVariant: [{ sortOrder: [{ by: 'Apprlevel'}, { by: 'Apprlevel', direction: #ASC } ],
                          visualizations: [{type: #AS_LINEITEM}],
                          text: 'Approver Log' }]
                          }
annotate entity zc_bank_stat_log
    with 
{
      @UI.facet:
   [

   {
   id: 'Generalitem1',
   isSummary: true,
   label: 'Approver Log',
   type: #COLLECTION,
   purpose: #STANDARD
   },

   { type: #FIELDGROUP_REFERENCE,
    targetQualifier: 'GeneralData1',
    parentId: 'Generalitem',
    position: 1,
    label: 'Section 1',
    id: 'GeneralData1' } ]

  @UI: { lineItem: [{ position: 10 }],
    identification: [{ position: 10 }],
    fieldGroup: [{ qualifier: 'GeneralData1', position: 10, importance: #HIGH }] }
  Accountingdoc;
  @UI: { lineItem: [{ position: 20 }],
  identification: [{ position: 20 }],
  fieldGroup: [{ qualifier: 'GeneralData1', position: 20, importance: #HIGH }] }
  Fiscalyear;
  @UI: { lineItem: [{ position: 30 }],
  identification: [{ position: 30 }],
  fieldGroup: [{ qualifier: 'GeneralData1', position: 30, importance: #HIGH }] }
  Companycode;
  @UI: { lineItem: [{ position: 40 }],
  identification: [{ position: 40 }],
  fieldGroup: [{ qualifier: 'GeneralData1', position: 40, importance: #HIGH }] }
  Actionedby;
  @UI: { lineItem: [{ position: 40 }],
  identification: [{ position: 40 }],
  fieldGroup: [{ qualifier: 'GeneralData1', position: 40, importance: #HIGH }] }
  Name;
  @UI: { lineItem: [{ position: 50 }],
  identification: [{ position: 50 }],
  fieldGroup: [{ qualifier: 'GeneralData1', position: 50, importance: #HIGH }] }
  Actionedon;
  @UI: { lineItem: [{ position: 60 }],
  identification: [{ position: 60 }],
  fieldGroup: [{ qualifier: 'GeneralData1', position: 60, importance: #HIGH }] }
  Actionedat;
  @UI: { lineItem: [{ position: 70 }],
  identification: [{ position: 70 }],
  fieldGroup: [{ qualifier: 'GeneralData1', position: 70, importance: #HIGH }] }
  Action;
  @UI: { lineItem: [{ position: 80 }],
  identification: [{ position: 80 }],
  fieldGroup: [{ qualifier: 'GeneralData1', position: 80, importance: #HIGH }] }
  Apprlevel;
  @UI: { lineItem: [{ position: 90 }],
  identification: [{ position: 90 }],
  fieldGroup: [{ qualifier: 'GeneralData1', position: 90, importance: #HIGH }] }
  Apprcomment;
    
}