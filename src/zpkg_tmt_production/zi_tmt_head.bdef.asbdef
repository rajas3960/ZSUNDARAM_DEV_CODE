managed implementation in class zbp_i_tmt_head unique;
strict ( 1 );
with draft;

define behavior for ZI_TMT_HEAD //alias <alias_name>
persistent table zdt_tmt_head
draft table zdr_tmt_head
lock master
total etag postingdate
authorization master ( instance )
//etag master <field_name>
{
  create;
  update ( features : instance );
  delete ( features : instance );
  field ( readonly : update, numbering : managed ) id;
  field ( mandatory : create, readonly : update ) productionorder,  postingdate, activity ,  noofbatch;

  field ( readonly ) Referenceid, Plant, Material , Materialdesc , Avlquantity , Uom , Status , Total ,department;
  draft action Edit;
  draft action Activate;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare;

  action ( features : instance ) CONSCHECK result [1] $self;
  action ( features : instance ) POSTCNF result [1] $self;
  action ( features : instance ) POST101 result [1] $self;
  action ( features : instance ) POST261 result [1] $self;
  action ( features : instance ) POST531 result [1] $self;
  action ( features : instance ) GETCONS result [1] $self;

  side effects
  { action POSTCNF affects  messages;
    action CONSCHECK affects  messages;
    action POST101 affects  messages;
    action POST261 affects  messages;
    action POST531 affects  messages;
    action GETCONS affects  messages;
  }

  determination headerdetails1 on modify { field productionorder ; field postingdate; }
  determination headerdetails on save { create; }
  association _item4 { create ( features : instance );  }
  association _item2 { create ( features : instance ); }
  association _item5 { create ( features : instance ); }
  association _item3 { create ( features : instance ); }
  association _item1 { create ( features : instance ); }
  association _item { create ( features : instance ); }
}

