@Metadata.layer: #CUSTOMER
@UI: { headerInfo: {
typeName: 'GST Integration',
typeNamePlural: 'GST Integration',
title: { type: #STANDARD, value: 'Invoiceno' } } }
@UI.createHidden: true
@UI.updateHidden: true
@UI.deleteHidden: true
annotate entity ZGST_INVOICE_UPPV
    with 
{
  @UI.facet: [ { id:              'Header',
                        purpose:         #STANDARD,
                        type:            #IDENTIFICATION_REFERENCE,
                        label:           'Standard Header',
                        position:        10 },
                        
                        { id: 'GSTStatus',
                          label: 'GST Upload Status',
                          type: #LINEITEM_REFERENCE,
                          targetElement: '_Status',
                          position: 20 } ]
                        
  @UI:{ lineItem: [{ position: 10, label: 'Invoice No' }],
        identification: [{ position: 10, label: 'Invoice No' },
       { type: #FOR_ACTION, dataAction: 'GSTUPLOAD', label: 'GST POST',position: 10 }          
          ] }
  @UI.selectionField: [{ position: 20 }]
  @EndUserText.label: 'Invoice No'
invoiceno;
  @UI:{ lineItem: [{ position: 20, label: 'Invoice Date' }],
        identification: [{ position: 20, label: 'Invoice Date' } ] }
  @EndUserText.label: 'Invoice Date'
invoicedt;
  @UI:{ lineItem: [{ position: 30, label: 'Transaction Type' }],
        identification: [{ position: 30, label: 'Transaction Type' } ] }
  @EndUserText.label: 'Transaction Type'
transtypecode;
  @UI:{ lineItem: [{ position: 40, label: 'Filing Period' }],
        identification: [{ position: 40, label: 'Filing Period' } ] }
  @EndUserText.label: 'Filing Period'
MonthYear;
  @UI:{ lineItem: [{ position: 50, label: 'ack_sr_no' }],
        identification: [{ position: 50, label: 'ack_sr_no' } ] }
  @EndUserText.label: 'ack_sr_no'
AccountingDocument;
  @UI:{ lineItem: [{ position: 60, label: 'Self GSTIN' }],
        identification: [{ position: 60, label: 'Self GSTIN' } ] }
  @EndUserText.label: 'Self GSTIN'
selfgstin;
  @UI:{ lineItem: [{ position: 70, label: 'System CD' }],
        identification: [{ position: 70, label: 'System CD' } ] }
  @EndUserText.label: 'Company Code'
  @Consumption.valueHelpDefinition: [{ entity: { name: 'I_CompanyCodeStdVH', element: 'CompanyCode' }}]  
  @Consumption.filter.mandatory: true
  @UI.selectionField: [{ position: 10 }]  
systemcd;
  @UI:{ lineItem: [{ position: 80, label: 'Branch CD' }],
        identification: [{ position: 80, label: 'Branch CD' } ] }
  @EndUserText.label: 'Branch CD'
branchcd;
  @UI:{ lineItem: [{ position: 90, label: 'Vertical CD' }],
        identification: [{ position: 90, label: 'Vertical CD' } ] }
  @EndUserText.label: 'Vertical CD'
verticalcd;
  @UI:{ lineItem: [{ position: 100, label: 'Result Flag' }],
        identification: [{ position: 100, label: 'Result Flag' } ] }
  @EndUserText.label: 'Result Flag'
resultflag;
  @UI:{ lineItem: [{ position: 110, label: 'Invoice Type' }],
        identification: [{ position: 110, label: 'Invoice Type' } ] }
  @EndUserText.label: 'Invoice Type'
invoicetype;
  @UI:{ lineItem: [{ position: 110, label: 'Customer GSTIN' }],
        identification: [{ position: 110, label: 'Customer GSTIN' } ] }
  @EndUserText.label: 'Customer GSTIN'
cpgstin;
  @UI:{ lineItem: [{ position: 120, label: 'Customer Name' }],
