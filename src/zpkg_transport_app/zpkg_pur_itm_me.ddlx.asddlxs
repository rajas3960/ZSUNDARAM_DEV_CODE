@Metadata.layer: #CUSTOMER
@UI:{
    headerInfo: {
        typeName: 'Tranport app Report ',
        typeNamePlural: 'Tranport app Reports',
        title: { type: #STANDARD, value: 'PurchaseOrder' }
    }
}
annotate entity ZPV_PUR_ITM
    with 
{

