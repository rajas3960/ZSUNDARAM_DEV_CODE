@Metadata.layer: #CUSTOMER
@UI:{
    headerInfo: {
        typeName: 'Tranport app Report ',
        typeNamePlural: 'Tranport app Reports',
        title: { type: #STANDARD, value: 'Purchase_Order' }
    }
}
annotate entity ZPV_PUR_HDR
    with 
{
  
    @UI.facet: [ { id:              'Purchase_Order',
                      purpose:         #STANDARD,
                      type:            #IDENTIFICATION_REFERENCE,
                      label:           'Purchase_Order',
                      position:        10 } ,
                    { id:              'Purchase_Order_Item',
                      purpose:         #STANDARD,
                      type:            #LINEITEM_REFERENCE,
                      label:           'Purchase order Item',
                      position:        20,
                      targetElement:   '_Item'} ]

    @UI.lineItem: [{ position: 10, label: 'Purchase Order' }]
    @UI.identification: [{ position: 10, label: 'Purchase Order' }]
    @EndUserText.label: 'Purchase Order'
    @UI.selectionField: [{ position: 10 }]
    Purchase_Order;
    @UI.lineItem: [{ position: 20, label: 'Supplier Invoice' }]
    @UI.identification: [{ position: 20, label: 'Supplier Invoice' }]
