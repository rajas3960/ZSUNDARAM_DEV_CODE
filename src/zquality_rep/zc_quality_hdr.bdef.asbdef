projection;
strict ( 1 );
use draft;
use side effects;

define behavior for ZC_QUALITY_HDR //alias <alias_name>
{
  use create;
  use update;
  //use delete;


  use action Edit;
  use action Activate;
  use action Resume;
  use action Discard;
  use action Prepare;

  use action Print;
  use action Delete;

  use association _Item { with draft; }
}

define behavior for ZC_QUALITY_ITM //alias <alias_name>
{
  use update;
  use delete;

  use association _Head;
}