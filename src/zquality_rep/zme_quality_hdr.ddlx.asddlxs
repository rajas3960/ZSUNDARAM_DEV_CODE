@Metadata.layer: #CUSTOMER
@UI: { headerInfo: {
typeName: 'Quality Print',
typeNamePlural: 'Quality Print',
title: { type: #STANDARD, value : 'qc_cert_no'}
}}
@UI: { presentationVariant: [{ sortOrder: [{ by: 'Invdate', direction: #DESC }],
                               visualizations: [{ type: #AS_LINEITEM }],
                               text: 'Invoice No' }] }
annotate view ZC_QUALITY_HDR with
{

  @UI.facet:
    [{ id: 'header', isSummary: true, label: 'Header', type: #COLLECTION },

    // { type: #FIELDGROUP_REFERENCE,  purpose: #STANDARD, targetQualifier: 'fg2', parentId: 'header', position: 10, label: 'Quality Header', id: 'fg1' },
     { type: #FIELDGROUP_REFERENCE, targetQualifier: 'fg1', parentId: 'header', position: 15, label: 'User Details', id: 'fg2' },

     { id: 'item', label: 'Item', type: #LINEITEM_REFERENCE, position : 25, targetElement: '_Item' }]
  @UI.lineItem: [ { position: 1 } ]
  @UI.identification: [ { position: 1 } ]
  @UI.fieldGroup: [ { position: 1,  qualifier: 'fg1', importance: #HIGH } ]
  @UI.selectionField: [ { position: 10 } ]

  @UI.hidden: true
  Id;
  @UI: { lineItem: [{ position: 05 }],
     identification: [{ position: 05 }],
     fieldGroup: [{ qualifier: 'fg1', position: 05, importance: #HIGH }] }
  qc_cert_no;

  @UI.lineItem: [ { position: 06 }, { criticality: 'Criticality' } ]
  @UI.identification: [  { position: 06 } ]
  @UI.fieldGroup: [ { position: 06,  qualifier: 'fg1', importance: #HIGH } ]
  status;

  @UI: { selectionField: [{ position: 10 }],
       lineItem: [{ position: 10 }],
       identification: [{ position: 10 }],
       fieldGroup: [{ qualifier: 'fg1', position: 10, importance: #HIGH }] }

  @Consumption.valueHelpDefinition: [{
        entity:{
        element: 'BillingDocument',
        name:'ZI_BillingDocument_QA'
        },

           distinctValues: true,
        useForValidation: true,
        enabled: ''
        }
      ]
  Billingdoc;

  @UI.hidden: true
  billingitem;

  @UI: {lineItem: [{ position: 70 }],
  identification: [{ position: 70 }],
  fieldGroup: [{ qualifier: 'fg1', position: 70, importance: #HIGH }] }
  vehicleno;

  @UI: {lineItem: [{ position: 30 }],
  identification: [{ position: 30 }],
  fieldGroup: [{ qualifier: 'fg1', position: 30, importance: #HIGH }] }
  Plant;

  @UI: {lineItem: [{ position: 30 }],
  identification: [{ position: 30 }],
  fieldGroup: [{ qualifier: 'fg1', position: 30 , importance: #HIGH }] }
  quantity;

  @UI: {lineItem: [{ position: 30 }],
  identification: [{ position: 30 }],
  fieldGroup: [{ qualifier: 'fg1', position: 30, importance: #HIGH }] }

  @Consumption.valueHelpDefinition: [{
        entity:{
        element: 'Material',
        name:'ZI_INVMATQUAL_V1'
        },

    distinctValues: true,
        useForValidation: true,
        enabled: '',

  additionalBinding:
       [

       {
        localParameter: '',
        localElement: 'Billingdoc',
        localConstant: '',
        parameter: '',
        element: 'BillingDocument',
        usage: #FILTER
         }
          ]

        }
      ]
  material;

  @UI: { lineItem: [{ position: 50 }],
  identification: [{ position: 50 }],
  fieldGroup: [{ qualifier: 'fg1', position: 50, importance: #HIGH }] }
  //@UI.hidden: true
