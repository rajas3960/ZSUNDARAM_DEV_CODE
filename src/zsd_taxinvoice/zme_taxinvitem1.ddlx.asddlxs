@Metadata.layer: #CUSTOMER

@UI: { headerInfo: { title: { type: #STANDARD, label: 'Tax Invoice Item', value: 'BillingDocument' } } }
@UI.presentationVariant: [{ sortOrder: [{by: 'BillingDocumentItem',direction: #ASC}] }]
annotate entity ZC_TAXINVITEM
    with 
{
  @UI.facet: [
  {
  id: 'item',
  isSummary: true,
  label: 'Tax Invoice Item',
  type: #COLLECTION,
  purpose: #STANDARD
  },

