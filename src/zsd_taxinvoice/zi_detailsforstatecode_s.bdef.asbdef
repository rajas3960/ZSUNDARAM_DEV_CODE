managed with additional save implementation in class ZBP_I_DETAILSFORSTATECODE_S unique;
strict;
with draft;
define behavior for ZI_DetailsForStateCode_S alias DetailsForStateCAll
draft table ZDT_STATECO_D_S
with unmanaged save
lock master total etag LastChangedAtMax
authorization master( global )

{
  field ( readonly )
   SingletonID;

  field ( features : instance )
   TransportRequestID;

  field ( notrigger )
   SingletonID,
   LastChangedAtMax;


  update;
  internal create;
  internal delete;

  draft action ( features : instance ) Edit with additional implementation;
  draft action Activate optimized;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare;
  action ( features : instance ) SelectCustomizingTransptReq parameter D_SelectCustomizingTransptReqP result [1] $self;

  association _DetailsForStateCode { create ( features : instance ); with draft; }

  validation ValidateTransportRequest on save ##NOT_ASSIGNED_TO_DETACT { create; update; }

  side effects {
    action SelectCustomizingTransptReq affects $self;
  }
  }

define behavior for ZI_DetailsForStateCode alias DetailsForStateCode ##UNMAPPED_FIELD
persistent table ZDT_STATECODE
draft table ZDT_STATECODE_D
etag master LocalLastChangedAt
lock dependent by _DetailsForStateCAll
authorization dependent by _DetailsForStateCAll

{
  field ( readonly )
   SingletonID,
   Id,
   LastChangedAt,
   LocalLastChangedAt,
