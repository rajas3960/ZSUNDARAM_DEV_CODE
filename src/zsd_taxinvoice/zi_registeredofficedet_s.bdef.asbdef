managed with additional save implementation in class ZBP_I_REGISTEREDOFFICEDET_S unique;
strict;
with draft;
define behavior for ZI_RegisteredOfficeDet_S alias RegisteredOfficeAll
draft table ZDT_REGOFFI_D_S
with unmanaged save
lock master total etag LastChangedAtMax
authorization master( global )

{
  field ( readonly )
   SingletonID;

  field ( features : instance )
   TransportRequestID;

  field ( notrigger )
   SingletonID,
   LastChangedAtMax;


  update;
  internal create;
  internal delete;

  draft action ( features : instance ) Edit with additional implementation;
  draft action Activate optimized;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare {
    validation RegisteredOfficeDet ~ ValidateDataConsistency;
  }
  action ( features : instance ) SelectCustomizingTransptReq parameter D_SelectCustomizingTransptReqP result [1] $self;

  association _RegisteredOfficeDet { create ( features : instance ); with draft; }

  validation ValidateTransportRequest on save ##NOT_ASSIGNED_TO_DETACT { create; update; }

  side effects {
    action SelectCustomizingTransptReq affects $self;
  }
  }

define behavior for ZI_RegisteredOfficeDet alias RegisteredOfficeDet ##UNMAPPED_FIELD
persistent table ZDT_REGOFFICE
draft table ZDT_REGOFFICE_D
etag master LocalLastChangedAt
lock dependent by _RegisteredOfficeAll
authorization dependent by _RegisteredOfficeAll

{
  field ( readonly )
   SingletonID,
   Id,
   LastChangedAt,
   LocalLastChangedAt,
   ConfigDeprecationCode,
   ConfigDeprecationCode_Critlty;

  field ( numbering : managed )
   Id;

  field ( notrigger )
   SingletonID,
   LastChangedAt,
   LocalLastChangedAt;


  update( features : global );
  delete( features : instance );

  action ( features : instance ) Deprecate result [1] $self;
  action ( features : instance ) Invalidate result [1] $self;
  factory action ( features : instance ) CopyRegisteredOfficeDet [1];

  mapping for ZDT_REGOFFICE
  {
    Id = ID;
    CompanyCode = COMPANY_CODE;
    RegOffice = REG_OFFICE;
    Email = EMAIL;
    Contact = CONTACT;
    Website = WEBSITE;
    Cin = CIN;
    ConfigDeprecationCode = CONFIGDEPRECATIONCODE;
    LastChangedAt = LAST_CHANGED_AT;
    LocalLastChangedAt = LOCAL_LAST_CHANGED_AT;
  }

  association _RegisteredOfficeAll { with draft; }

  validation ValidateTransportRequest on save ##NOT_ASSIGNED_TO_DETACT { create; update; delete; }
  validation ValidateDataConsistency on save { create; update; }
}