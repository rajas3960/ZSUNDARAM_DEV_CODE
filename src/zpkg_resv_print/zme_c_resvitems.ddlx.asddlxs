@Metadata.layer: #CUSTOMER

@UI: {
  presentationVariant: [{ sortOrder: [{ by: 'ReservationItem', direction:  #ASC }],
                          visualizations: [{type: #AS_LINEITEM}],
                          text: 'Reservation Item' }]
     }

@UI: { headerInfo: { title: { type: #STANDARD, label: 'Reservation Item', value: 'Reservation' } } }
annotate entity zc_resvitems with
{

  @UI.facet: [
   {
   id: 'item',
   isSummary: true,
   label: 'Reservation Item',
   type: #COLLECTION,
   purpose: #STANDARD
   },

   {
   type: #FIELDGROUP_REFERENCE,
   targetQualifier: 'item1',
   parentId: 'item',
   label: 'Primary Charc.',
   id: 'item1'
   }
                 ]
  @UI: {    identification: [{position: 10 }],
  lineItem: [{position: 10 }],
  fieldGroup: [{qualifier: 'item1',position: 10,importance: #HIGH }] }
  Reservation;
  @UI: {    identification: [{position: 20 }],
  lineItem: [{position: 20 }],
  fieldGroup: [{qualifier: 'item1',position: 20,importance: #HIGH }] }
  ReservationItem;
  //  @UI: {    identification: [{position: 30 }],
  //  lineItem: [{position: 30 }],
  //  fieldGroup: [{qualifier: 'item1',position: 30,importance: #HIGH }] }
  @UI.hidden: true
  RecordType;
  @UI: {    identification: [{position: 40 }],
  lineItem: [{position: 40 }],
  fieldGroup: [{qualifier: 'item1',position: 40,importance: #HIGH }] }
  Plant;
  @UI: {    identification: [{position: 50 }],
  lineItem: [{position: 50 }],
  fieldGroup: [{qualifier: 'item1',position: 50,importance: #HIGH }] }
  StorageLocation;
  @UI: {    identification: [{position: 60 }],
  lineItem: [{position: 60 }],
  fieldGroup: [{qualifier: 'item1',position: 60,importance: #HIGH }] }
  Product;
  @UI: {    identification: [{position: 70 }],
  lineItem: [{position: 70 }],
  fieldGroup: [{qualifier: 'item1',position: 70,importance: #HIGH }] }
  Batch;
  @UI: {    identification: [{position: 80 }],
  lineItem: [{position: 80 }],
  fieldGroup: [{qualifier: 'item1',position: 80,importance: #HIGH }] }
  ValuationType;
  @UI: {    identification: [{position: 90 }],
  lineItem: [{position: 90 }],
  fieldGroup: [{qualifier: 'item1',position: 90,importance: #HIGH }] }
  GoodsMovementType;
}