projection;
strict ( 1 );

define behavior for ZFI_HEAD_PV //alias <alias_name>
{
  use create;
  use update;
  use delete;

  use action PDF;
  use action Email;

  use association _Item { create; }
}

define behavior for ZFI_ITEM_PV //alias <alias_name>
{
  use update;
  use delete;

  use association _Head;
}