@Metadata.layer: #CUSTOMER
@UI: { headerInfo: {
typeName: 'Credit - Debit Note',
typeNamePlural: 'Credit - Debit Note',
title: { type: #STANDARD, value: 'AccountingDocument' } } }
@UI.createHidden: true
@UI.updateHidden: true
@UI.deleteHidden: true
annotate entity ZFI_HEAD_PV
    with 
{
  @UI.facet: [ { id:              'Header',
                        purpose:         #STANDARD,
                        type:            #IDENTIFICATION_REFERENCE,
                        label:           'Standard Header',
                        position:        10 },
                        { id:              'Items',
                          purpose:         #STANDARD,
                          type:            #LINEITEM_REFERENCE,
                          label:           'Standard Item',
                          position:        20,
                          targetElement:   '_Item'}
//                        { id: 'PurchaseStatus',
//                          purpose: #HEADER,
//                          type: #DATAPOINT_REFERENCE,
//                          position: 10,
//                          targetQualifier: 'POStatus'
//                          },
//                        { id: 'User',
//                          purpose: #HEADER,
//                          type: #DATAPOINT_REFERENCE,
//                          position: 20,
//                          targetQualifier: 'UserId'
//                          }                          
                          ]
  @UI:{ lineItem: [{ position: 10, label: 'Accounting Document' }],
          identification: [{ position: 10, label: 'Accounting Document' },
       { type: #FOR_ACTION, dataAction: 'PDF', label: 'Get PDF Output',position: 10 },
       { type: #FOR_ACTION, dataAction: 'Email', label: 'Send-Email',position: 20 }          
          ] }
  @UI.selectionField: [{ position: 10 }]
  @EndUserText.label: 'Accounting Document'
AccountingDocument;
  @UI:{ lineItem: [{ position: 20, label: 'Fiscal Year' }],
          identification: [{ position: 20, label: 'Fiscal Year' }] }
  @UI.selectionField: [{ position: 20 }]
  @EndUserText.label: 'Fiscal Year'
FiscalYear;
  @UI:{ lineItem: [{ position: 30, label: 'Company Code' }],
          identification: [{ position: 30, label: 'Company Code' }] }
  @UI.selectionField: [{ position: 30 }]
  @Consumption.valueHelpDefinition: [{ entity: { name: 'I_CompanyCodeStdVH', element: 'CompanyCode' }}]  
  @EndUserText.label: 'Company Code'
CompanyCode;
  @UI:{ lineItem: [{ position: 40, label: 'Document Type' }],
          identification: [{ position: 40, label: 'Document Type' }] }
  @UI.selectionField: [{ position: 40 }]
  @EndUserText.label: 'Document Type'
AccountingDocumentType;
  @UI:{ lineItem: [{ position: 50, label: 'Document Date' }],
          identification: [{ position: 50, label: 'Document Date' }] }
  @EndUserText.label: 'Document Date'
DocumentDate;
  @UI:{ lineItem: [{ position: 60, label: 'Reference Document' }],
          identification: [{ position: 60, label: 'Reference Document' }] }
  @EndUserText.label: 'Reference Document'
OriginalReferenceDocument;
  @UI:{ lineItem: [{ position: 70, label: 'Date Of Invoice' }],
          identification: [{ position: 70, label: 'Date Of Invoice' }] }
  @EndUserText.label: 'Date Of Invoice'
PostingDate;
  @UI:{ lineItem: [{ position: 80, label: 'Supplier' }],
          identification: [{ position: 80, label: 'Supplier' }] }
  @EndUserText.label: 'Supplier'
Supplier;
  @UI.identification: [{ position: 90, label: 'Currency' }]
  @EndUserText.label: 'Currency'
CompanyCodeCurrency;
  @UI.identification: [{ position: 100, label: 'Plant' }]
  @EndUserText.label: 'Plant'
Plant;
  @UI.identification: [{ position: 110, label: 'Street Name' }]
  @EndUserText.label: 'Street Name'
StreetName;
  @UI.identification: [{ position: 120, label: 'Street Add1' }]
  @EndUserText.label: 'Street Add1'
StreetPrefixName1;
  @UI.identification: [{ position: 130, label: 'Street Add2' }]
  @EndUserText.label: 'Street Add2'
StreetPrefixName2;
  @UI.identification: [{ position: 140, label: 'City' }]
  @EndUserText.label: 'City'
CityName;
  @UI.identification: [{ position: 150, label: 'Postal Code' }]
  @EndUserText.label: 'Postal Code'
PostalCode;
  @UI.identification: [{ position: 160, label: 'Region' }]
  @EndUserText.label: 'Region'
Region;
  @UI.identification: [{ position: 170, label: 'Country' }]
  @EndUserText.label: 'Country'
Country;
  @UI.identification: [{ position: 180, label: 'Time Zone' }]
  @EndUserText.label: 'Time Zone'
AddressTimeZone;
  @UI.identification: [{ position: 190, label: 'Form Output' }]
  @EndUserText.label: 'Form Output'
formtype;
  @UI.lineItem: [{ position: 90, label: 'Form Output' }]
  @UI.identification: [{ position: 200, label: 'Form Output' }]
  @EndUserText.label: 'Form Output'
attachment;
@UI.hidden: true
filename;
@UI.hidden: true
mimetype;
@UI.hidden: true
createdby;
