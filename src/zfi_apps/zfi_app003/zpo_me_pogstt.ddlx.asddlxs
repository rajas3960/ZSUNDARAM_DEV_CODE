SourceLedger;
@UI.hidden: true
FiscalYear;
@UI.hidden: true
clientid;


@UI.hidden: true
CgstRate;
@UI.hidden: true
CgstType;


@UI.hidden: true
IgstRate;
@UI.hidden: true
IgstType;


@UI.hidden: true
createdname;

