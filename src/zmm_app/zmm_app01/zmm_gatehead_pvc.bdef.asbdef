projection;
strict ( 1 );
use draft;
use side effects;

define behavior for ZMM_GATEHEAD_PVC //alias <alias_name>
{
  use create;
  use update;
  use delete;

  use action PRINT;
  use action SETOUT;
  use action GENGATE;
  use action BGR;
  use action CANCEL;
  use action GENITEM;
  use action DEL;
  use action PGI;
  use action UPD;
  use action INV;
  use action GETINV;

  use action Edit;
  use action Activate;
  use action Resume;
  use action Discard;
  use action Prepare;

  use association _Item1 { create; with draft; }
  use association _Item { create; with draft; }
}

define behavior for ZMM_GATEITEM_PVC alias item1
{
  use update;
  use delete;

  use action CONFIRM;
  use action CONFIRMS;
  use action QtyStatus;

  use association _Head { with draft; }
}

define behavior for ZMM_POHEAD_PVC //alias <alias_name>
{
  use update;
  use delete;

  use association _Head { with draft; }
}