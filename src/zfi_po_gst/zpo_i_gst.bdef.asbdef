managed implementation in class zbp_po_i_gst unique;
strict ( 2 );
with draft;

define behavior for ZPO_I_GST //alias <alias_name>
//persistent table <???>
with unmanaged save
draft table zpo_gst_draft
lock master
total etag DocumentDate
authorization master ( instance )
etag master DocumentDate
{
  create ( authorization : global );
  update;
  delete;
  field ( readonly ) FiscalYear, CompanyCode, AccountingDocument, SourceLedger, LedgerGLLineItem,
  DocumentDate, AccountingDocumentType, Supplier, Fiscalperiod, Selfgstin,
  clientid, BPSupplierFullName, SupGSTIN, TransType, Resultflag, TaxCode,
  InvoiceValue, CgstAmt, CgstRate, CgstType, SgstAmt, IgstAmt, IgstRate,
  IgstType, TaxableValue, statuscode, ackno, createdname, createdby, createdat;
  draft action ( features : instance ) Edit;
  draft action Activate optimized;
  draft action Resume;
  draft action Discard;
  draft determine action Prepare;

  action ( features : instance ) POGST_POST result [1] $self;
}