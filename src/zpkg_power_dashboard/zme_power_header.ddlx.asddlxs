  Power;
  @UI.identification: [{position: 85 },  { type: #FOR_ACTION, dataAction: 'GETCONS', label: 'Fetch Consumption'} ]
  @UI.fieldGroup: [ { position: 85, qualifier: 'GeneralData3', importance: #HIGH } ]
  getcons;
  @UI.identification: [{position: 85 },  { type: #FOR_ACTION, dataAction: 'TRANSFER', label: 'Transfer'} ]
  @UI.fieldGroup: [ { position: 85, qualifier: 'GeneralData3', importance: #HIGH } ]
  transfer;

}