managed implementation in class zbp_r_print_queue unique;
strict;
with draft;
define behavior for ZR_PRINT_QUEUE //alias <alias_name>
persistent table zdt_printqueue
draft table zdr_printqueue
etag master Erdat
lock master
total etag Erdat
authorization master ( instance )
{
  create;
  update ( features : instance );
  delete ( features : instance );
  draft action ( features : instance ) Edit;
  draft action Activate;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare;
  field ( readonly, numbering : managed ) Id;
  //field ( readonly ) Cbuser, Printque;

  validation mandatefieldsheader on save { create; update; }
  mapping for zr_print_queue
    {
      Cbuser   = Cbuser;
      Erdat    = Erdat;
      Printque = Printque;
    }
}