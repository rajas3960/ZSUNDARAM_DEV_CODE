@Metadata.layer: #CORE

@UI: { headerInfo: {
typeName: 'Transation Details',
typeNamePlural: 'Transation Details',
title: { type: #STANDARD, value: 'Transactionid' }
}}

@UI: {
  presentationVariant: [{ sortOrder: [{ by: 'Status', direction: #ASC } ],
                          visualizations: [{type: #AS_LINEITEM}]
                           }]
                          }
annotate view ZC_TRANSATION_REPORT with
{
  @UI.facet:
     [{ id: 'GeneralData', isSummary: true, label: 'Transation Details', type: #COLLECTION },
      { type: #FIELDGROUP_REFERENCE, targetQualifier: 'GeneralData1', parentId: 'GeneralData', position: 1, label: 'Section 1', id: 'GeneralData1' },
       {
     id: 'Generalitem',
     label: 'Error Log',
     type: #LINEITEM_REFERENCE,
     targetElement: '_Item',
     position:  2
     }
     ]

  @Search.defaultSearchElement: true
  @UI: { lineItem: [{ position: 10 }],
     identification: [{ position: 10 }],
     fieldGroup: [{ qualifier: 'GeneralData1', position: 10, importance: #HIGH }] }
  Transactionid;
  @Search.defaultSearchElement: true
  @UI: { lineItem: [{ position: 20 }],
       identification: [{ position: 20 }],
       fieldGroup: [{ qualifier: 'GeneralData1', position: 20, importance: #HIGH }] ,
       selectionField: [{ position: 10 }] }
  Utr;
  @Search.defaultSearchElement: true
  @UI: { lineItem: [{ position: 30 }],
      identification: [{ position: 30 }],
      fieldGroup: [{ qualifier: 'GeneralData1', position: 30, importance: #HIGH }]
       }
  Remittername;
  @UI: { lineItem: [{ position: 40 }],
      identification: [{ position: 40 }],
      fieldGroup: [{ qualifier: 'GeneralData1', position: 40, importance: #HIGH }]
       }
  Fromaccountnumber;
  @UI: { lineItem: [{ position: 50 }],
      identification: [{ position: 50 }],
      fieldGroup: [{ qualifier: 'GeneralData1', position: 50, importance: #HIGH }]
     }
  Frombankname;
  @UI: { lineItem: [{ position: 60 }],
      identification: [{ position: 60 }],
      fieldGroup: [{ qualifier: 'GeneralData1', position: 60, importance: #HIGH }] }
  Remitterifsc;
  @UI: { lineItem: [{ position: 70 }],
     identification: [{ position: 70 }],
     fieldGroup: [{ qualifier: 'GeneralData1', position: 70, importance: #HIGH }],
     selectionField: [{ position: 20 }] }
  Virtualaccount;
  @UI: { lineItem: [{ position: 80 }],
       identification: [{ position: 80 }],
       fieldGroup: [{ qualifier: 'GeneralData1', position: 80, importance: #HIGH }] }
  Amount;
  @UI: { lineItem: [{ position: 90 }],
       identification: [{ position: 90 }],
       fieldGroup: [{ qualifier: 'GeneralData1', position: 90, importance: #HIGH }] }
  Mmid;
  @UI: { lineItem: [{ position: 100 }],
       identification: [{ position: 100 }],
       fieldGroup: [{ qualifier: 'GeneralData1', position: 100, importance: #HIGH }] }
  Valuedate;
  @UI: { lineItem: [{ position: 110 }],
       identification: [{ position: 110 }],
       fieldGroup: [{ qualifier: 'GeneralData1', position: 110, importance: #HIGH }] }
  Transfermode;
  @UI: { lineItem: [{ position: 120 }],
      identification: [{ position: 120 }],
      fieldGroup: [{ qualifier: 'GeneralData1', position: 120, importance: #HIGH }] ,
      selectionField: [{ position: 30 }] }
  Creditdate;
  @UI: { lineItem: [{ position: 125 }],
     identification: [{ position: 125 }],
     fieldGroup: [{ qualifier: 'GeneralData1', position: 120, importance: #HIGH }] }
  Credittime;
  @UI: { lineItem: [{ position: 130 }],
      identification: [{ position: 130 }],
      fieldGroup: [{ qualifier: 'GeneralData1', position: 130, importance: #HIGH }] }
  Chequeno;
  @UI: { lineItem: [{ position: 140 }],
      identification: [{ position: 140 }],
      fieldGroup: [{ qualifier: 'GeneralData1', position: 140, importance: #HIGH }] }
  Narration;
  @UI: { lineItem: [{ position: 150 }],
       identification: [{ position: 150 }],
       fieldGroup: [{ qualifier: 'GeneralData1', position: 150, importance: #HIGH }] }
  Accountingdoc;
  @UI: { lineItem: [{ position: 160 }],
       identification: [{ position: 160 }],
       fieldGroup: [{ qualifier: 'GeneralData1', position: 160, importance: #HIGH }] }
  Companycode;
  @UI: { lineItem: [{ position: 170 }],
      identification: [{ position: 170 }],
      fieldGroup: [{ qualifier: 'GeneralData1', position: 170, importance: #HIGH }] }
  Fiscalyear;
  @UI: { lineItem: [{ position: 180 }],
      identification: [{ position: 180 }],
      fieldGroup: [{ qualifier: 'GeneralData1', position: 180, importance: #HIGH }] }
  Waers;
  @Search.defaultSearchElement: true
  @Consumption.valueHelpDefinition: [{ entity:
  {name: 'ZV_STATUS' , element: 'status' },
  distinctValues: true
  }]
  @UI.lineItem: [ { position: 12 }, { criticality: 'Criticality' } ]
  @UI.identification: [  { position: 12 } ]
  @UI.fieldGroup: [ { position: 12,  qualifier: 'GeneralData1', importance: #HIGH } ]
  @UI.selectionField: [{ position: 40 }]
  Status;
  @UI: { lineItem: [{ position: 185 }],
     identification: [{ position: 185 }],
     fieldGroup: [{ qualifier: 'GeneralData1', position: 190, importance: #HIGH }] }
  error_count;
  @UI: { lineItem: [{ position: 190 }],
      identification: [{ position: 190 }],
      fieldGroup: [{ qualifier: 'GeneralData1', position: 190, importance: #HIGH }] }
  Createdon;
  @UI: { lineItem: [{ position: 200 }],
      identification: [{ position: 200 }],
      fieldGroup: [{ qualifier: 'GeneralData1', position: 200, importance: #HIGH }] }
  Createdat;
  @UI: { lineItem: [{ position: 210 }],
     identification: [{ position: 210 }],
     fieldGroup: [{ qualifier: 'GeneralData1', position: 210, importance: #HIGH }] }
  mailsent;
  @UI: { lineItem: [{ position: 220 }],
  identification: [{ position: 220 }],
      fieldGroup: [{ qualifier: 'GeneralData1', position: 220, importance: #HIGH }] }
  mailsentat;
  @UI: { lineItem: [{ position: 230 }],
   identification: [{ position: 230 }],
   fieldGroup: [{ qualifier: 'GeneralData1', position: 230, importance: #HIGH }] }
  mailsenton;
  @UI: {
         identification: [{position: 240 },  { type: #FOR_ACTION, dataAction: 'Post', label: 'Post'} ]
  }
  Post;
  @UI.hidden: true
  Criticality;
  @UI.lineItem: [{ position: 11, type: #AS_DATAPOINT }]
  @UI.dataPoint: { visualization: #PROGRESS ,
                   targetValueElement: 'Total',
                   criticality: 'Criticality',
                   criticalityRepresentation: #WITHOUT_ICON }
  Progress;


}